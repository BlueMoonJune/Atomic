{
  "schemaVersion": 1,
  "id": "atomic",
  "version": "${version}",
  "name": "Atomic",
  "description": "A collection of tweaks for BTA you can pick-and-choose",
  "authors": [
    "BlueMoonJune - Lead Developer"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/bta-atomic",
    "sources": "https://github.com/BlueMoonJune/Atomic",
    "issues": "https://github.com/BlueMoonJune/Atomic/issues"
  },

	"icon": "icon.png",
  "license": "CC0-1.0",
  "environment": "*",
  "entrypoints": {
    "main": [
			"bluemoonjune.atomic.Atomic"
    ]
	},

  "mixins": [
		"atomic.mixins.json"
  ],

	"accessWidener": "atomic.accesswidener",
	"depends": {
		"fabricloader": ">=${fabricloader}",
		"minecraft": "*",
		"java": ">=${java}"
	},

	"suggests": {
		"modmenu": ">=${modmenu}"
	}
}
